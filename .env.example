# Public RevenueCat Android SDK key (safe to include in the mobile app).
# Configure the app, entitlement, offering, and Google Play products in RevenueCat first.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Ads use Google's test banner unit in development and preview builds.
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_ADS_MODE=test
